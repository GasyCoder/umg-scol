APP_NAME="UMG Bourse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Deux portails servis par le même backend, routés par hôte (tout autre hôte = 404).
# Développement : ajouter dans /etc/hosts
#   127.0.0.1 scol.umg.test
#   127.0.0.1 bourse.umg.test
# puis `php artisan serve --port=8000` et ouvrir http://scol.umg.test:8000 / http://bourse.umg.test:8000.
# Les domaines ne contiennent jamais de port ; APP_URL est l'URL du portail interne.
APP_URL=http://scol.umg.test:8000
SCOL_DOMAIN=scol.umg.test
BOURSE_DOMAIN=bourse.umg.test
PORTAL_COOKIE_PREFIX=umg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Créer cette base MySQL et un utilisateur dédié avant les migrations.
# Renseigner le mot de passe uniquement dans le .env local, jamais dans Git.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=umg_bourse
DB_USERNAME=umg_bourse
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Ignoré par les portails : chaque portail a son propre cookie host-only. Mettre true en production (HTTPS).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# L'OTP étudiant exige un vrai transport (le mailer `log` est refusé).
# Exemple de développement : Mailpit en local sur 127.0.0.1:1025 ; en production, le SMTP institutionnel.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Provisionnement explicite : php artisan db:seed
# Ne jamais versionner les valeurs réelles. Le mot de passe existant n'est pas remplacé.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Portail étudiant : aucune valeur secrète réelle dans Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://bourse.umg.test:8000/api/student/auth/google/callback
